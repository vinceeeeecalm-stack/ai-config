# Mobile console: keep application source and docs, exclude local/runtime state.
!mobile-investment-console/
!mobile-investment-console/**
mobile-investment-console/.git/
mobile-investment-console/.netlify/
mobile-investment-console/node_modules/
mobile-investment-console/dist/
mobile-investment-console/coverage/
mobile-investment-console/data/
mobile-investment-console/.env
mobile-investment-console/.env.*
mobile-investment-console/*.log

# Runtime, market caches, ledgers, reports, paper state, and private artifacts stay outside Git.
$CODEX_HOME/
automations/
outputs/
runtime/
state/
tmp/
**/.DS_Store
**/.sports-run-state/
**/.sports_run_guard/
**/cache/
**/data/
**/experiments/
**/handoffs/
**/paper_trades/
**/performance/
**/recommendations/
**/reports/
**/runtime/
**/subagent_outputs/
**/subagent_tasks/
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.db
**/*.log
**/.env
**/.env.*
