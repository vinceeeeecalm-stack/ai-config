{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "recommendation-execution-calendar-v3-history-event-current-decision",
  "timezone": "Asia/Shanghai",
  "applies_to": [
    "intraday_scalp",
    "us_tactical",
    "crypto_tactical",
    "dca",
    "long_term_add",
    "formal_watch",
    "no_deploy_candidate"
  ],
  "intraday_scalp_required_fields": [
