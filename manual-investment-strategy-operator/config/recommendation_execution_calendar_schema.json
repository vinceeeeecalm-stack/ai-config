    "entry_trigger",
    "cancel_if",
    "latest_close_at",
    "max_loss_budget",
    "max_account_risk_pct",
    "planned_position_size",
    "binary_event_inside_window",
    "overnight_allowed"
  ],
  "required_fields": [
