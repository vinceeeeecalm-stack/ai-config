# Copy to a local ignored env file outside git tracking, then fill your own keys.
# Never commit real API keys.

# US equities / ETFs / fundamentals
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
TWELVE_DATA_API_KEY=your_twelve_data_key_here
FINNHUB_API_KEY=your_finnhub_key_here
FMP_API_KEY=your_financial_modeling_prep_key_here

# Crypto aggregated market data
COINGECKO_DEMO_API_KEY=your_coingecko_demo_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here

# Crypto exchange market data only. Do not use trading or withdrawal permissions.
BINANCE_API_KEY=your_binance_market_data_key_here

# Macro
FRED_API_KEY=your_fred_key_here

# SEC EDGAR does not require an API key, but requires a declared user agent.
SEC_USER_AGENT="Vincent Pan personal research vincent@example.com"
