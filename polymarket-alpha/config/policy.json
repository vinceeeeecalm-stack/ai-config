{
  "version": "polymarket-alpha-v1.0",
  "paper_only": true,
  "live_orders_enabled": false,
  "private_api_used": false,
  "real_money_execution_authorized": false,
  "initial_equity_usd": 500.0,
  "max_open_positions": 2,
  "max_risk_pool_pct": 8.0,
  "default_risk_pool_pct": 5.0,
  "primary_allocation_pct": 100.0,
  "two_candidate_allocation_pct": [60.0, 40.0],
  "early_stage_sizing": {
    "active": true,
    "ordinary_position_equity_pct": [2.0, 5.0],
    "exceptional_position_max_equity_pct": 8.0,
    "minimum_closed_paper_trades_for_review": 30,
    "preferred_closed_paper_trades_for_review": 50,
    "require_positive_net_roi": true,
    "require_positive_clv": true,
    "require_positive_calibration_evidence": true,
    "automatic_risk_increase_allowed": false
  },
  "manual_decision_report": {
    "enabled": true,
    "max_watch_items": 4,
    "max_recommendations": 2,
    "manual_confirmation_required_for_real_money": true,
    "guarantee_daily_report_not_daily_opportunity": true
  },
  "in_play_exit_policy": {
    "enabled": true,
    "live_data_max_age_seconds": 120,
    "de_risk_when_model_edge_lte": 0.02,
    "full_exit_when_model_edge_lte": 0.0,
    "profit_lock_price_gain_per_share": 0.10,
    "recover_stake_price_gain_per_share": 0.20,
    "hold_min_probability": 0.85,
    "hold_min_confidence_lower": 0.75,
    "hold_min_remaining_edge": 0.02,
    "hold_min_remaining_upside": 0.05,
    "partial_sell_fraction": 0.33,
    "large_profit_partial_sell_fraction": 0.50
  },
  "high_win_small_return_gate": {
    "enabled": true,
    "min_model_probability": 0.90,
    "preferred_model_probability": 0.95,
    "min_confidence_lower": 0.85,
    "preferred_confidence_lower": 0.90,
    "min_independent_oos_samples": 30,
    "preferred_independent_oos_samples": 50,
    "min_net_ev_per_share_exclusive": 0.0,
    "require_calibration_bin_alignment": true,
    "require_not_materially_worse_than_market": true,
    "max_daily_recommendations": 1,
    "position_equity_pct": [0.5, 2.0],
    "tail_risk_label": "低收益、高尾部损失风险",
    "cannot_displace_alpha_primary": true
  },
  "experimental_research_gate": {
    "enabled": true,
    "minimum_research_probability": 0.65,
    "minimum_confidence_lower": 0.5,
    "minimum_alpha_net_edge_per_share": 0.05,
    "high_win_minimum_probability": 0.9,
    "high_win_minimum_confidence_lower": 0.85,
    "high_win_minimum_net_ev_exclusive": 0.0,
    "minimum_official_sources": 1,
    "minimum_independent_sources": 2,
    "maximum_calibrated_samples_exclusive": 30,
    "position_equity_pct": [0.5, 1.0],
    "maximum_daily_recommendations": 1,
    "required_label": "尚未证明真实胜率达到80%",
    "real_money_recommendation_allowed": false
  },
  "entry_gate": {
    "min_model_probability": 0.80,
    "min_confidence_lower": 0.72,
    "min_net_edge_per_share": 0.045,
    "min_independent_sources": 2,
    "require_official_source": true,
    "require_clear_rules": true,
    "max_price_impact_per_share": 0.01,
    "max_spread_per_share": 0.02,
    "min_hours_to_expiry": 0.0,
    "max_days_to_expiry": 1.0,
    "secondary_research_max_days_to_expiry": 30.0,
    "daily_priority": true,
    "min_calibration_samples": 30,
    "allow_uncalibrated_research": false,
    "uncertainty_discount": 0.01,
    "resolution_risk_reserve": 0.005
  },
  "friction": {
    "fee_model": "per_market_fee_schedule",
    "fee_formula": "shares * fee_rate * price * (1-price)",
    "require_fee_schedule_when_enabled": true,
    "fee_round_decimals": 5,
    "extra_slippage_bps": 5.0
  },
  "evaluation": {
    "clv_min_horizon_minutes": 60,
    "max_observation_gap_hours": 6
  },
  "domains": [
    "sports",
    "politics",
    "macro",
    "crypto",
    "technology",
    "social_count",
    "other"
  ]
}
